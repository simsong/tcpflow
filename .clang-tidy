# Analyze the C/C++ build using the captured compilation database.
# Clang's path-sensitive checkers cover memory and API correctness.
# Findings fail the CI job; dependency headers are not separate targets.
# Formatting and naming preferences are intentionally outside this gate.
# The full scan-build and cppcheck jobs provide independent analyses.
# C11 Annex K is unavailable on supported platforms; bounded memset is valid.
# Keep path-sensitive bounds checks without flagging every C memory operation.
Checks: '-*,clang-analyzer-*,-clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling'
WarningsAsErrors: 'clang-analyzer-*'
HeaderFilterRegex: '.*'
